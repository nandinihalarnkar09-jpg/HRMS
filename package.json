{
  "name": "lehar-hr",
  "version": "1.0.0",
  "private": true,
  "description": "Lehar HR: HRMS for Konkan Coastal Foods (Employee Master, Attendance, Leave, Ask HR agent)",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:integration": "tsx --env-file-if-exists=.env.local --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "test:agent": "tsx --env-file-if-exists=.env.local scripts/run-agent-tests.ts",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts --reset",
    "offline:setup": "tsx scripts/offline-setup.ts",
    "offline": "node scripts/offline-start.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@clerk/nextjs": "^6.34.0",
    "@electric-sql/pglite": "^0.3.0",
    "ai": "^5.0.0",
    "next": "16.3.4",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
