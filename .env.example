# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Database (Supabase → Project Settings → Database → Connection string → "Transaction pooler", port 6543)
DATABASE_URL=
# Optional: separate DB for `npm run test:integration` (it DROPS and recreates the schema)
TEST_DATABASE_URL=

# --- Clerk (dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Local development only: AUTH_MODE=dev shows a "pick a test user" login instead of Clerk.
# Refused automatically when NODE_ENV=production or on Vercel.
# AUTH_MODE=password: public DEMO deployment only (fictional data, demo passwords firstname@KCF2026).
AUTH_MODE=

# --- Email (resend.com → API Keys). Without a key, emails are only written to email_log.
RESEND_API_KEY=
EMAIL_FROM=Lehar HR <onboarding@resend.dev>
# Demo helper: send every email to this inbox instead (Resend sandbox only delivers to your own address)
EMAIL_REDIRECT_TO=

# --- AI agent: "google" (default) or "groq"
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Seed options (npm run db:setup)
# Test-login emails are <name>+clerk_test@example.com by default (Clerk dev code 424242).
SEED_EMAIL_DOMAIN=example.com

# --- Public app URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
